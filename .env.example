# Copy to .env and fill in. Never commit the real .env file.

SECRET_KEY=change-me

# Must be False in any deployed environment — True exposes SECRET_KEY and
# Reddit credentials on error pages. Defaults to False; set True for local dev.
DEBUG=True

# Optional — omit to use a local SQLite database (the default for dev).
# Example for Postgres: postgres://user:password@localhost:5432/red_sole_robot
# DATABASE_URL=

# Reddit (PRAW) credentials for the bot account moderating /r/LouboutinLife.
#
# NOTE: Reddit Data API access for this bot account is still pending
# approval as of 2026-07. When applying, cite this repository as evidence
# that the ingested data is used only for moderation assistance on
# /r/LouboutinLife — not for commercial purposes, not for training AI
# models, and not shared or repurposed beyond that.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=red_sole_robot moderation assistant
REDDIT_SUBREDDIT=LouboutinLife

# Raw item retention window (most recent N of each type kept, trimmed regardless of evaluation status).
RETAINED_COMMENT_CAP=5000
RETAINED_POST_CAP=100

# How many recent comments/posts the hourly reconciliation job fetches.
RECONCILE_COMMENT_FETCH_LIMIT=1000
RECONCILE_POST_FETCH_LIMIT=100

# How many parent-comment levels the preparation stage walks (fetching live
# from Reddit when an ancestor is no longer retained) to build context.
PREPARATION_MAX_ANCESTOR_DEPTH=5

# How long (seconds) a RawItem stays protected from trimming after being
# consulted as an ancestor, so a retried prepare_item can reuse it.
RAW_ITEM_PROTECTION_TTL_SECONDS=3600

# AI inference backend — any server exposing an OpenAI-compatible
# /v1/chat/completions endpoint (Ollama, llama.cpp server, vLLM, ...).
INFERENCE_BACKEND=openai_compatible
INFERENCE_BASE_URL=http://localhost:11434
INFERENCE_MODEL=
